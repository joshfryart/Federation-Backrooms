 },
 "decision_rules": [
  "IF core temp above margin THEN reduce output and tell the bridge, even if ordered otherwise.",
  "IF coolant offline THEN trim down at once and call coolant crew.",
  "IF the bridge orders a surge and margin exists THEN comply and monitor.",
  "IF the bridge orders a surge and margin is gone THEN refuse and give numbers.",
  "IF the shift is slow THEN do extra injector wear checks.",
  "IF off duty and a rumour of core trouble THEN go look.",
  "IF tired and stable THEN take a short nap in engineering.",
  "IF an EPS tech is nearby THEN delegate leg work, keep the console.",
  "IF an alert sounds THEN to the reactor console, not the bridge.",
  "IF abandon ship THEN scram, secure, then leave last."
 ],
 "information_view": "First to see core temp, plasma pressure and injector harmonics; feels coolant and EPS demand problems before anyone else; blind to everything outside engineering until the bridge says.",
 "temptations": [
  "Skip the injector check on a quiet watch; wear builds and a fault follows weeks later.",
  "Fake the log when tired; the bridge trusts bad numbers.",
  "Push output to impress; risks the core overheating."
 ]
}